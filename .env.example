# Copy to .env and fill in what you have. Every key is optional - the tool works with none.
# Several keys for one service (rotated when one runs out): comma-separate them (KEY=a,b), add numbered
# variables (KEY_2=c, KEY_3=d ...), or repeat the variable on another line. Applies to every *_API_KEY / APIFY_TOKEN.

# --- Search (people lookups, LinkedIn posts) ---
# tinyfish.ai - TinySearch free 12,000/day + TinyFetch free 1,000 URLs/day (used first). Key: agent.tinyfish.ai/api-keys
TINYFISH_API_KEY=
# Self-hosted OpenSERP (free, no key). Start once with:
#   docker run -d --init --name openserp -p 127.0.0.1:7000:7000 karust/openserp serve -a 0.0.0.0 -p 7000
OPENSERP_URL=http://127.0.0.1:7000
OPENSERP_MIN_GAP=45          # seconds between Google queries (lower = more captchas)
COOLDOWN_MINUTES=30          # rest a provider this long after a captcha / rate limit
# TINYSEARCH_MIN_GAP=2.2     # optional: seconds between TinySearch requests per key (its limit is 30/min)

# serper.dev - 2,500 free Google queries (one-time), no card
SERPER_API_KEY=

# --- Page fetching + exhibitor-list finder (JS-heavy exhibitor directories) ---
# firecrawl.dev - 1,000 free credits/month (1 credit per site map or page). Last-resort page fetch, finds a show's
# exhibitor-list page (./lf site-map) and reads lists that only load in a browser.
FIRECRAWL_API_KEY=
# FIRECRAWL_RESERVE=150      # optional: automatic steps stop when a key would drop below this many credits
# FIRECRAWL_MIN_GAP=6.5      # optional: seconds between Firecrawl requests per key (free plan: 10/min)

# --- Phase 2: LinkedIn profile check + post search (no LinkedIn login) ---
# apify.com - $5 free platform credit / month. Token: console.apify.com/settings/integrations
APIFY_TOKEN=
# brightdata.com - alternative profile checker (Authorization: Bearer)
BRIGHTDATA_API_KEY=
# ai-ark.com - LinkedIn people search by company NAME (0.5 credit per person; 100 trial credits)
AI_ARK_API_KEY=
# Deepline (free people search, 5,000 results) needs no key here: install its CLI and sign in once:
#   pnpm add -g deepline   (or: npm install -g deepline)   then   deepline auth register
# Countries you want leads in (people elsewhere are flagged and skipped for email lookups)
TARGET_COUNTRIES=India,IN
# Location filters for direct LinkedIn search (Apify uses names, Bright Data uses ISO codes)
LINKEDIN_LOCATIONS=India
LINKEDIN_COUNTRY_CODE=IN

# --- Phase 2: email waterfall (tried in this order, stops at the first good email) ---
# prospeo.io - free monthly credits, charged only when a verified email is found
PROSPEO_API_KEY=
# hunter.io - free plan includes API; its company->domain finder is free
HUNTER_API_KEY=
# apollo.io - free account must be registered with a work email
APOLLO_API_KEY=
# tomba.io - 25 searches / 30 days free; needs key + secret
TOMBA_API_KEY=
TOMBA_API_SECRET=
# bettercontact.rocks - 50 free credits once; itself a waterfall of providers
BETTERCONTACT_API_KEY=
# (Snov.io is not supported: its free trial has no API access.)
